+/*
+ * Drop all transient remapper state. Called when a device disappears
+ * mid-stroke: the pending key-up will never arrive, so the keys keyd
+ * already emitted must be released and any held layers/chords cleared.
+ */
+void kbd_reset(struct keyboard *kbd)
+{
+	size_t i;
+
+	clear(kbd);
+
+	/*
+	 * Layer 0 is the main layer and must stay active; only reset
+	 * transient layers above it.
+	 */
+	for (i = 1; i < ARRAY_SIZE(kbd->layer_state); i++)
+		memset(&kbd->layer_state[i], 0, sizeof(kbd->layer_state[i]));
+
+	memset(&kbd->layer_state[0], 0, sizeof(kbd->layer_state[0]));
+	kbd->layer_state[0].active = 1;
+	kbd->layer_state[0].activation_time = 0;
+
+	memset(kbd->keystate, 0, sizeof(kbd->keystate));
+	memset(kbd->cache, 0, sizeof(kbd->cache));
+	memset(kbd->active_chords, 0, sizeof(kbd->active_chords));
+	memset(&kbd->chord, 0, sizeof(kbd->chord));
+	kbd->chord.state = CHORD_INACTIVE;
+	memset(&kbd->pending_timeout, 0, sizeof(kbd->pending_timeout));
+	memset(&kbd->pending_overload, 0, sizeof(kbd->pending_overload));
+
+	kbd->active_macro = NULL;
+	kbd->nr_timeouts = 0;
+	kbd->scroll.active = 0;
+}
