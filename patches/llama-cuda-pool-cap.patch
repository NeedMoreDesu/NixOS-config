@@ -572,11 +624,147 @@ struct ggml_cuda_pool_leg : public ggml_cuda_pool {
     }
 
     void free(void * ptr, size_t size) override {
+        const bool capturing = is_capturing();
+        const bool pinned = pinned_ptrs.count(ptr) > 0;
+
+        if (capturing) {
+            // Inside a graph capture: never synchronize, evict or invalidate.
+            // Those operations are illegal during capture and deadlock the HIP
+            // runtime. Only cache the buffer; the graph being captured still
+            // references it, so mark it pinned (evict it only when the cap is
+            // exceeded outside a capture).
+            pinned_ptrs.insert(ptr);
+            for (int i = 0; i < MAX_BUFFERS; ++i) {
+                ggml_cuda_buffer& b = buffer_pool[i];
+                if (b.ptr == nullptr) {
+                    b.ptr = ptr;
+                    b.size = size;
+                    b.pinned = true;
+                    return;
+                }
+            }
+            // Pool full during capture: the only case we cannot cache. This is
+            // rare (256 slots) and decode capture uses few buffers.
+            GGML_LOG_DEBUG(GGML_CUDA_NAME " buffer pool full during capture, freeing directly\n");
+            ggml_cuda_set_device(device);
+            CUDA_CHECK(cudaFree(ptr));
+            pool_size -= size;
+            pinned_ptrs.erase(ptr);
+            invalidate_cuda_graphs();
+            return;
+        }
+
+        const size_t max_cached = ggml_cuda_pool_max_cached_bytes();
+
+        if (max_cached == SIZE_MAX) {
+            // unlimited cache: preserve the historical behavior exactly
+            for (int i = 0; i < MAX_BUFFERS; ++i) {
+                ggml_cuda_buffer& b = buffer_pool[i];
+                if (b.ptr == nullptr) {
+                    b.ptr = ptr;
+                    b.size = size;
+                    b.pinned = pinned;
+                    return;
+                }
+            }
+            GGML_LOG_DEBUG(GGML_CUDA_NAME " buffer pool full, increase MAX_CUDA_BUFFERS\n");
+            ggml_cuda_set_device(device);
+            CUDA_CHECK(cudaFree(ptr));
+            pool_size -= size;
+            pinned_ptrs.erase(ptr);
+            if (pinned) {
+                invalidate_cuda_graphs();
+            }
+            return;
+        }
+
+        size_t cached = 0;
+        for (int i = 0; i < MAX_BUFFERS; ++i) {
+            if (buffer_pool[i].ptr != nullptr) {
+                cached += buffer_pool[i].size;
+            }
+        }
+
+        // cap == 0 disables caching; an incoming buffer larger than the cap cannot be cached either
+        if (max_cached == 0 || size > max_cached) {
+            ggml_cuda_set_device(device);
+            CUDA_CHECK(cudaDeviceSynchronize());
+            CUDA_CHECK(cudaFree(ptr));
+            pool_size -= size;
+            pinned_ptrs.erase(ptr);
+            if (pinned) {
+                invalidate_cuda_graphs();
+            }
+            return;
+        }
+
+        bool evicted_pinned = false;
+        if (cached + size > max_cached) {
+            // Evict dead weight first: buffers no live graph references. Keep
+            // the graph-referenced (pinned) buffers resident as long as the
+            // budget allows. Largest-first within each class, so the smallest
+            // buffers survive. Only evicting a pinned buffer invalidates graphs.
+            ggml_cuda_set_device(device);
+            CUDA_CHECK(cudaDeviceSynchronize());
+            // pass 1: non-pinned buffers
+            while (cached + size > max_cached) {
+                int ibest = -1;
+                size_t best_size = 0;
+                for (int i = 0; i < MAX_BUFFERS; ++i) {
+                    const ggml_cuda_buffer & b = buffer_pool[i];
+                    if (b.ptr != nullptr && !b.pinned && b.size > best_size) {
+                        best_size = b.size;
+                        ibest = i;
+                    }
+                }
+                if (ibest < 0) {
+                    break;
+                }
+                ggml_cuda_buffer & b = buffer_pool[ibest];
+                CUDA_CHECK(cudaFree(b.ptr));
+                pool_size -= b.size;
+                cached -= b.size;
+                pinned_ptrs.erase(b.ptr);
+                b.ptr  = nullptr;
+                b.size = 0;
+                b.pinned = false;
+            }
+            // pass 2: only if the pinned set alone exceeds the cap
+            while (cached + size > max_cached) {
+                int ibest = -1;
+                size_t best_size = 0;
+                for (int i = 0; i < MAX_BUFFERS; ++i) {
+                    const ggml_cuda_buffer & b = buffer_pool[i];
+                    if (b.ptr != nullptr && b.size > best_size) {
+                        best_size = b.size;
+                        ibest = i;
+                    }
+                }
+                if (ibest < 0) {
+                    break;
+                }
+                ggml_cuda_buffer & b = buffer_pool[ibest];
+                CUDA_CHECK(cudaFree(b.ptr));
+                pool_size -= b.size;
+                cached -= b.size;
+                pinned_ptrs.erase(b.ptr);
+                b.ptr  = nullptr;
+                b.size = 0;
+                b.pinned = false;
+                evicted_pinned = true;
+            }
+        }
+
+        if (evicted_pinned) {
+            invalidate_cuda_graphs();
+        }
+
         for (int i = 0; i < MAX_BUFFERS; ++i) {
             ggml_cuda_buffer& b = buffer_pool[i];
             if (b.ptr == nullptr) {
                 b.ptr = ptr;
                 b.size = size;
+                b.pinned = pinned;
                 return;
             }
         }
@@ -584,7 +772,10 @@ struct ggml_cuda_pool_leg : public ggml_cuda_pool {
         ggml_cuda_set_device(device);
         CUDA_CHECK(cudaFree(ptr));
         pool_size -= size;
-        invalidate_cuda_graphs();
+        pinned_ptrs.erase(ptr);
+        if (pinned) {
+            invalidate_cuda_graphs();
+        }
     }
 };
 
