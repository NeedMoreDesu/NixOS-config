+// Maximum total bytes the legacy pool may retain in its free-buffer cache.
+// Unset means unlimited (the historical behavior).
+static size_t ggml_cuda_pool_max_cached_bytes() {
+    static const size_t max_cached = [] {
+        const char * env = getenv("GGML_CUDA_POOL_MAX_CACHED_MIB");
+        if (env == nullptr || env[0] == '\0') {
+            return (size_t) SIZE_MAX;
+        }
+        return (size_t) std::strtoull(env, nullptr, 10) * 1024 * 1024;
+    }();
+    return max_cached;
+}
