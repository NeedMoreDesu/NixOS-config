{
  // Managed by home-manager (assets/opencode/opencode.jsonc) — theme and
  // permissions are Nix policy; GUI/TUI theme-picker changes are
  // re-linked on next nyx.
  "$schema": "https://opencode.ai/config.json",
  "theme": "aura",
  // The `box` sandbox is the isolation boundary, so opencode's own
  // "outside the project" prompts are redundant: inspect any folder and
  // write scratch files under /tmp without asking.
  "permission": {
    "external_directory": "allow",
    "edit": {
      "/tmp/*": "allow"
    }
  },
  // Local Inkling 2 Mini, served by the llama-inkling user service
  // (home/local-ai.nix, port 8089). No auth: host loopback only.
  // This uses opencode's legacy provider entry: `providers` with
  // package/settings failed to resolve the model on 1.19.6, while
  // provider/npm works. `attachment`/`modalities` are what make the read
  // tool accept images; the mmproj is already loaded by llama-server.
  "provider": {
    "inkling": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Inkling 2 Mini (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8089/v1",
        "apiKey": "local"
      },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini UD-Q4_K_M",
          "attachment": true,
          "modalities": {
            "input": [ "text", "image" ],
            "output": [ "text" ]
          },
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
